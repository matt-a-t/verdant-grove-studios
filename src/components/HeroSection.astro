---
// Hero Section Component
---

<section class="hero">
  <div class="container hero-inner">
    <h1>Raised beds for intentional, seasonal living</h1>
    <p>
      Verdant Grove Studio creates bountiful, beautiful garden spaces for homes that value <strong>intention, beauty, and sustainability</strong>
    </p>
    <button class="button-secondary">Shop Our Fall Seedlings</button>
  </div>
</section>

<style>
  .hero {
    padding: var(--spacing-2xl) var(--spacing-lg);
    background:
      linear-gradient(120deg, rgba(24, 36, 30, 0.78), rgba(24, 36, 30, 0.55)),
      linear-gradient(120deg, rgba(38, 57, 47, 0.9), rgba(138, 179, 160, 0.88)),
      url('https://images.unsplash.com/photo-1523348837708-15d4a09cfac2?w=1800&h=1000&fit=crop') center/cover;
    color: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    max-width: 960px;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.82rem;
    margin-bottom: var(--spacing-xs);
    color: rgba(255, 255, 255, 0.9);
    font-weight: 700;
  }

  .hero h1 {
    color: var(--color-white);
    margin-bottom: var(--spacing-sm);
    max-width: 16ch;
  }

  .hero p {
    color: rgba(255, 255, 255, 0.95);
    max-width: 64ch;
    margin-bottom: var(--spacing-lg);
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--spacing-xl) var(--spacing-lg);
    }

    .hero h1 {
      max-width: 100%;
    }
  }
</style>
