---
// Offerings Section Component
---

<section id="offerings" class="offerings">
  <div class="container">
    <div class="offerings-grid">
      <!-- Fall 2026 -->
      <div class="pathway fall-pathway">
        <h3>Fall 2026 Offerings</h3>
        <p class="pathway-tagline">Start Growing This Season</p>
        
        <ul class="services-list">
          <li>
            <span class="service-icon">🌱</span>
            <h4>Seedlings</h4>
          </li>
          <li>
            <span class="service-icon">🛠️</span>
            <h4>Raised Bed Reset</h4>
          </li>
          <li>
            <span class="service-icon">🪴</span>
            <h4>Balcony Box Refresh</h4>
          </li>
        </ul>
      </div>

      <!-- Spring 2027 -->
      <div class="pathway spring-pathway">
        <h3>Spring 2027 Offerings</h3>
        <p class="pathway-tagline">Garden Installations</p>
        
        <ul class="services-list">
          <li>
            <span class="service-icon">🏡</span>
            <h4>Signature Gardens</h4>
          </li>
          <li>
            <span class="service-icon">📋</span>
            <h4>Planting Plans</h4>
          </li>
          <li>
            <span class="service-icon">🪴</span>
            <h4>Balcony Boxes</h4>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .offerings {
    background-color: var(--color-light-bg);
    padding: var(--spacing-2xl) var(--spacing-lg);
  }

  .container h2 {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
    color: var(--color-primary);
  }

  .offerings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .pathway {
    padding: 0;
  }

  .pathway:first-child {
    padding-right: var(--spacing-xl);
  }

  .pathway + .pathway {
    border-left: 1px solid var(--color-border);
    padding-left: var(--spacing-xl);
  }

  .pathway h3 {
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    text-align: center;
  }

  .pathway-tagline {
    font-size: 1rem;
    color: var(--color-accent);
    font-style: italic;
    margin-bottom: var(--spacing-lg);
    text-align: center;
  }

  .services-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    align-items: center;
  }

  .services-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
    justify-content: center;
  }

  .service-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .services-list h4 {
    font-size: 1rem;
    color: var(--color-dark-text);
    margin-top: 0.25rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .offerings-grid {
      grid-template-columns: 1fr;
    }

    .pathway:first-child {
      padding-right: 0;
      padding-bottom: var(--spacing-xl);
    }

    .pathway + .pathway {
      border-left: 0;
      border-top: 1px solid var(--color-border);
      padding-left: 0;
      padding-top: var(--spacing-xl);
    }
  }
</style>
