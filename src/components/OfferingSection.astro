---
// Offerings Section Component
---

<section id="offerings" class="offerings">
  <div class="container">
    <h2>Two Seasonal Pathways</h2>
    
    <div class="offerings-grid">
      <!-- Fall 2026 -->
      <div class="pathway fall-pathway">
        <h3>Fall 2026 Offerings</h3>
        <p class="pathway-tagline">Start Growing This Season</p>
        
        <ul class="services-list">
          <li>
            <span class="service-icon">🌱</span>
            <h4>Seedlings</h4>
          </li>
          <li>
            <span class="service-icon">🛠️</span>
            <h4>Raised Bed Reset</h4>
          </li>
          <li>
            <span class="service-icon">🪴</span>
            <h4>Balcony Box Refresh</h4>
          </li>
        </ul>
      </div>

      <!-- Spring 2027 -->
      <div class="pathway spring-pathway">
        <h3>Spring 2027 Offerings</h3>
        <p class="pathway-tagline">Garden Installations</p>
        
        <ul class="services-list">
          <li>
            <span class="service-icon">🏡</span>
            <h4>Signature Gardens</h4>
          </li>
          <li>
            <span class="service-icon">📋</span>
            <h4>Planting Plans</h4>
          </li>
          <li>
            <span class="service-icon">🪴</span>
            <h4>Balcony Boxes</h4>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .offerings {
    background-color: var(--color-light-bg);
    padding: var(--spacing-2xl) var(--spacing-lg);
  }

  .container h2 {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
    color: var(--color-primary);
  }

  .offerings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-2xl);
  }

  .pathway {
    background-color: var(--color-white);
    padding: var(--spacing-xl);
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    border-top: 4px solid var(--color-secondary);
  }

  .spring-pathway {
    border-top-color: var(--color-accent);
  }

  .pathway h3 {
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .pathway-tagline {
    font-size: 1rem;
    color: var(--color-accent);
    font-style: italic;
    margin-bottom: var(--spacing-lg);
  }

  .services-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .services-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
  }

  .service-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .services-list h4 {
    font-size: 1rem;
    color: var(--color-dark-text);
    margin-top: 0.25rem;
  }

  @media (max-width: 768px) {
    .offerings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
