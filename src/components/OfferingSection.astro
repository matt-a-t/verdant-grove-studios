---
// Offerings Section Component
---

<section id="offerings" class="offerings">
  <div class="container">
    <h2 class="motion-rise">Two Seasonal Pathways</h2>
    
    <div class="offerings-grid">
      <article class="pathway fall-pathway motion-rise">
        <h3>Fall 2026 Offerings</h3>
        <p class="pathway-tagline">Start Growing This Season</p>
        
        <ul class="services-list">
          <li>
            <h4><a href="/fall-seedlings-shop#individual-seedlings">Seedlings</a></h4>
          </li>
          <li>
            <h4><a href="/begin-your-garden">Raised Bed Reset</a></h4>
          </li>
          <li>
            <h4><a href="/begin-your-garden">Balcony Box Refresh</a></h4>
          </li>
        </ul>
        <a class="pathway-link" href="/fall-seedlings-shop">Explore the Fall Seedlings Shop</a>
      </article>

      <article class="pathway spring-pathway motion-rise">
        <h3>Spring 2027 Offerings</h3>
        <p class="pathway-tagline">Garden Installations</p>
        
        <ul class="services-list">
          <li>
            <h4><a href="/signature-gardens#spring-collections">Signature Gardens</a></h4>
          </li>
          <li>
            <h4><a href="/signature-gardens#installation-packages">Planting Plans</a></h4>
          </li>
          <li>
            <h4><a href="/spring-2027-installations#what-we-offer">Balcony Boxes</a></h4>
          </li>
        </ul>
        <a class="pathway-link" href="/spring-2027-installations">View Spring 2027 Installation Details</a>
      </article>
    </div>
  </div>
</section>

<style>
  .offerings {
    background:
      radial-gradient(circle at 20% 0%, rgba(198, 164, 122, 0.16), transparent 30%),
      var(--color-light-bg);
    padding: var(--spacing-2xl) var(--spacing-lg);
  }

  .container h2 {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
    color: var(--color-primary);
  }

  .offerings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-2xl);
  }

  .pathway {
    padding: 0 0 var(--spacing-sm);
    border-radius: 0;
    border-top: 2px solid var(--color-secondary);
    border-bottom: 1px solid var(--color-line);
  }

  .spring-pathway {
    border-top-color: var(--color-accent);
  }

  .pathway h3 {
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .pathway-tagline {
    font-size: 1rem;
    color: var(--color-accent);
    font-style: italic;
    margin-bottom: var(--spacing-lg);
  }

  .services-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .services-list li {
    padding-bottom: var(--spacing-xs);
    border-bottom: 1px dashed #d8cfbf;
  }

  .services-list h4 {
    font-size: 1rem;
    color: var(--color-dark-text);
    margin-top: 0.1rem;
  }

  .services-list a {
    color: inherit;
  }

  .pathway-link {
    margin-top: var(--spacing-md);
    display: inline-block;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .offerings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
