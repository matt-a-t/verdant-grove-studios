---
// Offerings Section Component
---

<section id="offerings" class="offerings">
  <div class="container">
    <div class="offerings-grid">
      <!-- Fall 2026 -->
      <div class="pathway fall-pathway">
        <div class="pathway-media">
          <img class="pathway-image" src="/brown-county-sunset.JPEG" alt="Warm sunset light over a fall garden landscape in Brown County." />
        </div>

        <div class="pathway-content">
          <h2>Fall 2026</h2>
          <a class="pathway-tagline pathway-button button-secondary" href="/fall-seedlings-shop/">Start Growing This Season</a>

          <ul class="services-list">
            <li>
              <h4>Seedlings</h4>
            </li>
            <li>
              <h4>Raised Bed Reset</h4>
            </li>
            <li>
              <h4>Balcony Box Refresh</h4>
            </li>
          </ul>
        </div>
      </div>

      <!-- Spring 2027 -->
      <div class="pathway spring-pathway">
        <div class="pathway-media">
          <img class="pathway-image" src="/washington-dc-tulips.jpeg" alt="Spring tulips in bloom in Washington, DC." />
        </div>

        <div class="pathway-content">
          <h2>Spring 2027</h2>
          <a class="pathway-tagline pathway-button pathway-button-spring" href="/spring-2027-installations/">Garden Installations</a>

          <ul class="services-list">
            <li>
              <h4>Signature Gardens</h4>
            </li>
            <li>
              <h4>Planting Plans</h4>
            </li>
            <li>
              <h4>Balcony Boxes</h4>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .offerings {
    background-color: var(--color-light-bg);
    padding: var(--spacing-2xl) var(--spacing-lg);
  }

  .pathway-content h2 {
    text-align: center;
    margin-bottom: var(--spacing-sm);
    color: var(--color-primary);
  }

  .offerings-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }

  .pathway {
    --pathway-tint: var(--color-accent);
    --pathway-overlay-direction: 90deg;
    --pathway-image-radius: 12px 0 0 12px;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 0;
    align-items: center;
    padding: 0;
    background-color: color-mix(in srgb, var(--pathway-tint) 34%, var(--color-white));
    border: 1px solid var(--pathway-tint);
    border-radius: 16px;
    overflow: hidden;
  }

  .spring-pathway {
    --pathway-tint: var(--color-secondary);
    --pathway-overlay-direction: 270deg;
    --pathway-image-radius: 0 12px 12px 0;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .pathway-media {
    position: relative;
    isolation: isolate;
  }

  .pathway-media::before {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .pathway-media::before {
    inset: 0;
    border-radius: var(--pathway-image-radius);
  }

  .spring-pathway .pathway-media {
    order: 2;
  }

  .spring-pathway .pathway-content {
    order: 1;
  }

  .pathway-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
    border-radius: var(--pathway-image-radius);
  }

  .pathway-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--spacing-xl);
  }

  .pathway h3 {
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    text-align: center;
  }

  .pathway-tagline {
    font-size: 1.2rem;
    margin-bottom: var(--spacing-lg);
    text-align: center;
  }

  .pathway-button {
    align-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-style: italic;
    line-height: 1.2;
  }

  .pathway-button-spring {
    background-color: var(--color-secondary);
    color: var(--color-hero);
    padding: var(--spacing-sm) var(--spacing-lg);
    font-weight: 600;
  }

  .pathway-button-spring:hover {
    background-color: var(--color-hero);
    color: var(--color-white);
  }

  .services-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    align-items: center;
  }

  .services-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
    justify-content: center;
  }

  .services-list h4 {
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--color-dark-text);
    margin-top: 0.25rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .pathway {
      --pathway-overlay-direction: 180deg;
      --pathway-image-radius: 12px 12px 0 0;
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    .spring-pathway {
      grid-template-columns: 1fr;
    }

    .spring-pathway .pathway-media,
    .spring-pathway .pathway-content {
      order: initial;
    }
  }
</style>
